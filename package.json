{
  "name": "@rakib045/agentic-sdlc-tools",
  "version": "0.2.0",
  "description": "Agentic AI SDLC kit — agents, skills, rules and slash commands (/spec, /plan, /build, /test, /code-review, /deploy) with multi-tool support (Claude, OpenCode, Codex, Gemini, GitHub Copilot).",
  "license": "MIT",
  "author": "Rakib Hasan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rakib045/agentic-sdlc-tools.git"
  },
  "homepage": "https://github.com/rakib045/agentic-sdlc-tools#readme",
  "bugs": {
    "url": "https://github.com/rakib045/agentic-sdlc-tools/issues"
  },
  "keywords": [
    "agentic-ai",
    "sdlc",
    "claude",
    "opencode",
    "codex",
    "gemini",
    "copilot",
    "cursor",
    "agents",
    "skills",
    "slash-commands"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agentic-sdlc-tools": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-templates.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "@types/node": "^22.9.0"
  }
}
